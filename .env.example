APP_ENV=development
POSTGRES_DB=telaviva
POSTGRES_USER=telaviva
POSTGRES_PASSWORD=telaviva_local
DATABASE_URL=postgresql+asyncpg://telaviva:telaviva_local@postgres:5432/telaviva
REDIS_URL=redis://redis:6379/0
API_CORS_ORIGINS=["http://localhost:5173"]
VITE_API_URL=http://localhost:8000
# Pode apontar para um host diferente da API HTTP durante a homologação.
VITE_LIVE_SOCKET_URL=http://localhost:8000
# Sala efêmera para validar dados ao vivo sem gravação nem persistência.
VITE_HOMOLOG_SOCKET_PATH=/homolog/live
# Opcional: quando existir uma transmissão real, informe seu UUID para usar /streams/{id}/live.
VITE_HOMOLOG_STREAM_ID=
